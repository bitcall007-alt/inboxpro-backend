# ============================================================
# InboxPro Backend v2.1 — Variables de entorno
# Copia este archivo como .env y completa los valores
# NUNCA subas .env a GitHub
# ============================================================

# ---- BASE DE DATOS (CRÍTICO — soluciona el bug de reinicios) ----
# En Railway: clic en "New" → "Database" → "Add PostgreSQL"
# Railway inyecta DATABASE_URL automáticamente. NO la escribas a mano en Railway.
# Solo úsala aquí en local para pruebas con un Postgres local o el de Railway.
DATABASE_URL=postgresql://usuario:password@host:5432/railway

# ---- SMTP PRINCIPAL (Brevo) ----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu_email@ejemplo.com
SMTP_PASS=tu_api_key_de_brevo

# ---- SMTP BACKUP (opcional — Mailgun) ----
SMTP2_HOST=smtp.mailgun.org
SMTP2_PORT=587
SMTP2_USER=
SMTP2_PASS=

# ---- SMTP BACKUP 2 (opcional — Amazon SES) ----
SMTP3_HOST=email-smtp.us-east-1.amazonaws.com
SMTP3_PORT=587
SMTP3_USER=
SMTP3_PASS=

# ---- SEGURIDAD ----
API_SECRET=cambia_esto_por_una_clave_segura_larga
ALLOWED_ORIGINS=http://localhost:3000,https://tu-frontend.netlify.app

# ---- LÍMITES ANTI-STRIKE ----
MAX_BOUNCE_RATE=2
MAX_DAILY_EMAILS=300
MAX_EMAILS_PER_REQUEST=500
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# ---- SERVIDOR ----
PORT=3000
NODE_ENV=production
