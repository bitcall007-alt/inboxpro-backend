# InboxPro v2.3 environment. Keep real values out of GitHub.

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://usuario:password@host:5432/neondb?sslmode=require

# Free email sending from Render (SMTP is blocked on Render Free)
BREVO_API_KEY=

# Single-user app login; set these privately in Render
APP_USERNAME=malik
APP_PASSWORD=
SESSION_SECRET=

# Optional: required only for the Brevo complaint webhook
API_SECRET=

# GitHub Pages site origin
ALLOWED_ORIGINS=https://bitcall007-alt.github.io

# Keep aligned with Brevo Free plan
MAX_DAILY_EMAILS=300
MAX_BOUNCE_RATE=2
MAX_EMAILS_PER_REQUEST=500
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
PORT=3000
NODE_ENV=production
